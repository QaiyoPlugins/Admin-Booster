msgid "Tidy admin notices"
msgstr "Упорядочить уведомления администратора"

msgid "Collapse stacked admin notices into a small counter tray."
msgstr "Сворачивайте нагромождённые уведомления администратора в небольшой лоток со счётчиком."

msgid "Dashboard cleanup"
msgstr "Очистка консоли"

msgid "Hide the dashboard widgets you never use."
msgstr "Скрывайте виджеты консоли, которыми вы никогда не пользуетесь."

msgid "Duplicate content"
msgstr "Дублирование контента"

msgid "One-click “Duplicate” as a draft from the list view."
msgstr "«Дублировать» одним кликом как черновик из списка."

msgid "Scheduled countdown"
msgstr "Обратный отсчёт для запланированных"

msgid "Show “Publishing in 3 days” on scheduled posts."
msgstr "Показывайте «Публикация через 3 дня» у запланированных записей."

msgid "Sticky table headers"
msgstr "Закреплённые заголовки таблиц"

msgid "Keep list-table column headers visible while scrolling."
msgstr "Держите заголовки столбцов таблицы видимыми при прокрутке."

msgid "Last edited column"
msgstr "Столбец последнего изменения"

msgid "Who last edited each item and how long ago."
msgstr "Кто последним редактировал каждый элемент и как давно."

msgid "Quick status switch"
msgstr "Быстрое переключение статуса"

msgid "Publish or unpublish from the list without opening the editor."
msgstr "Публикуйте или снимайте с публикации прямо из списка, не открывая редактор."

msgid "Hide the default dashboard widgets you do not use. Requires the “Dashboard cleanup” module."
msgstr "Скрывайте стандартные виджеты консоли, которыми не пользуетесь. Требуется модуль «Очистка консоли»."

msgid "Hide these widgets"
msgstr "Скрыть эти виджеты"

msgid "Enable all"
msgstr "Включить все"

msgid "Disable all"
msgstr "Выключить все"

msgid "Go Pro"
msgstr "Перейти на Pro"

msgid "%d power-user upgrades — see them below."
msgstr "%d улучшений для опытных пользователей — смотрите ниже."

msgid "Admin menu editor"
msgstr "Редактор меню администратора"

msgid "Rename, reorder and hide wp-admin menu items per user role — give editors and clients a clean, focused admin without touching code."
msgstr "Переименовывайте, переупорядочивайте и скрывайте пункты меню wp-admin по ролям — дайте редакторам и клиентам чистую, сфокусированную панель без кода."

msgid "Inline list-table editing"
msgstr "Встроенное редактирование таблицы-списка"

msgid "Edit titles, statuses, collections and custom fields straight in the list table — spreadsheet-style, without opening each item."
msgstr "Редактируйте заголовки, статусы, коллекции и произвольные поля прямо в таблице-списке — как в таблице, не открывая каждый элемент."

msgid "Login screen customizer"
msgstr "Настройка экрана входа"

msgid "Replace the WordPress logo, background and colors on the login screen with your own brand, plus custom CSS — no extra plugin needed."
msgstr "Замените логотип, фон и цвета WordPress на экране входа своим брендом, плюс пользовательский CSS — без дополнительных плагинов."

msgid "Activity log"
msgstr "Журнал активности"

msgid "A clear audit trail of who changed what and when — posts, settings, users and uploads — so nothing happens on your site unnoticed."
msgstr "Чёткий аудит того, кто, что и когда изменил — записи, настройки, пользователи и загрузки — чтобы на вашем сайте ничего не происходило незаметно."

msgid "Admin dark mode"
msgstr "Тёмная тема администратора"

msgid "A polished dark theme for the whole wp-admin, with a one-click toggle in the admin bar and a per-user preference."
msgstr "Отполированная тёмная тема для всего wp-admin, с переключателем в один клик в панели администратора и настройкой для каждого пользователя."

msgid "Revision cleaner"
msgstr "Очистка ревизий"

msgid "Limit how many revisions each post keeps and bulk-delete old ones to shrink a bloated database and speed up your admin."
msgstr "Ограничьте, сколько ревизий хранит каждая запись, и массово удаляйте старые, чтобы уменьшить раздутую базу данных и ускорить админку."

msgid "Explore Qaiyo Plugins"
msgstr "Обзор плагинов Qaiyo"

msgid "Explore Qaiyo"
msgstr "Обзор Qaiyo"

